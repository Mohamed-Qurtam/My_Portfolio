# Deploy only the production surface; everything else stays out of the build
/*
!/.vercelignore
!/index.html
!/index.css
!/index.js
!/404.html
!/robots.txt
!/sitemap.xml
!/Mohamed_Qurtam-Security_Engineer-CV.pdf
!/vercel.json
!/_headers
!/.well-known/
!/.well-known/security.txt
!/fonts/
!/images/
!/Badges/
